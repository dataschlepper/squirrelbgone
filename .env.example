RTSP_URL=rtsp://<username>:<password>@<camera-ip>:554/h264Preview_01_sub
# Single-class squirrel-only model (current):
MODEL_PATH=models/squirrelbgone_best.pt
# Multi-class model after training v2 notebook:
# MODEL_PATH=models/squirrelbgone_v2_best.pt
# Bird suppression model (optional) — set to yolov8n.pt to enable; leave empty to disable.
# Note: the COCO model can misclassify squirrels as birds. Only enable if needed.
MODEL_PATH_BIRD=
# Wildlife suppression model (optional) — suppresses squirrel triggers when deer/fox/raccoon/etc. present.
# Download from Roboflow: rf.workspace().project("animal-detection-yolov8").version(4).download("yolov8")
# then point MODEL_PATH_WILDLIFE at the exported weights file.
MODEL_PATH_WILDLIFE=
WILDLIFE_CONFIDENCE_THRESHOLD=0.45
TARGET_FPS=5
CONFIDENCE_THRESHOLD=0.45
BIRD_CONFIDENCE_THRESHOLD=0.45
LOG_DIR=logs
FRAMES_DIR=frames
# Phase 2+: GPIO trigger
GPIO_PIN=18
COOLDOWN_SEC=10
DAY_START=7
DAY_END=20
SPRAY_DURATION_SEC=1.0
