[Unit]
Description=SquirrelBGone API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=squirrelpi
WorkingDirectory=/home/squirrelpi/squirrelbgone
ExecStart=/home/squirrelpi/sbg-env/bin/uvicorn api.server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
SyslogIdentifier=squirrelbgone-api

[Install]
WantedBy=multi-user.target
